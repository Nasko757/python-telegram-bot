from telegram.ext import Updater, CommandHandler, MessageHandler, Filters

# Remplacez par votre token
TOKEN = 'VOTRE_TOKEN_ICI'

def start(update, context):
    """Envoie un message de bienvenue lorsque le bot est démarré."""
    update.message.reply_text("Bienvenue sur notre groupe !")

def new_member(update, context):
    """Message de bienvenue pour un nouvel utilisateur."""
    for member in update.message.new_chat_members:
        update.message.reply_text(f"Bienvenue {member.first_name} ! 🎉")

def main():
    """Lance le bot."""
    updater = Updater(TOKEN, use_context=True)
    dp = updater.dispatcher

    dp.add_handler(MessageHandler(Filters.status_update.new_chat_members, new_member))
    dp.add_handler(CommandHandler("start", start))

    updater.start_polling()
    updater.idle()

if __name__ == '__main__':
    main()
